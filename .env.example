# AgentAssure Environment Configuration Template

APP_NAME="AgentAssure"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration
# Local SQLite for testing: sqlite:///./agentassure.db
# PostgreSQL for production: postgresql://agentassure:agentassure_password@localhost:5432/agentassure_prod
DATABASE_URL="sqlite:///./agentassure.db"
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_ALWAYS_EAGER=true

# Security & Authentication
SECRET_KEY="production_secure_secret_key_change_in_env_32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM="HS256"

# Smart Sampling Weights (Must sum to 1.0)
SAMPLING_WEIGHT_JUDGE_SCORE=0.35
SAMPLING_WEIGHT_ASR_ERROR=0.25
SAMPLING_WEIGHT_LOOP_COUNT=0.20
SAMPLING_WEIGHT_CUSTOMER_DROPOFF=0.10
SAMPLING_WEIGHT_NEGATIVE_SENTIMENT=0.10

# Release Gating
CRITICAL_PASS_THRESHOLD=0.95
STANDARD_PASS_THRESHOLD=0.88
STATISTICAL_ALPHA=0.05

# Integrations
OPENAI_API_KEY="sk-mock-openai-key"
ANTHROPIC_API_KEY="sk-ant-mock-key"
LINEAR_API_KEY="lin_api_mock"
JIRA_BASE_URL="https://company.atlassian.net"
JIRA_API_TOKEN="mock_jira_token"
JIRA_USER_EMAIL="qa-lead@agentassure.internal"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/mock/webhook"

# Data Retention
ARCHIVE_RETENTION_DAYS=60
PURGE_RETENTION_DAYS=90
